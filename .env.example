# Chave da API xAI (console.x.ai > API Keys)
XAI_API_KEY=
XAI_API_HOST=api.x.ai

# Modelos padrão
XAI_CHAT_MODEL=grok-4.7
XAI_CODE_MODEL=grok-4.7
XAI_IMAGE_MODEL=grok-imagine-image-2.0
XAI_VIDEO_MODEL=grok-imagine-video

# Voz (TTS)
XAI_TTS_VOICE=eve
XAI_TTS_LANGUAGE=pt

# Pasta onde arquivos gerados (mp3, etc.) são salvos
OUTPUT_DIR=./output

# Transporte do MCP: stdio | streamable-http
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000
